# ── Supernova IA ─────────────────────────────────────────────────────────────
# Copie ce fichier en .env si tu veux changer les réglages serveur.
# Les clés d'API ne vont PAS ici : elles se saisissent dans l'interface
# (Paramètres → Connexion IA) et restent dans le localStorage du navigateur.

# Port du site localhost (défaut : 3000)
PORT=3000

# Hôte d'écoute (0.0.0.0 pour exposer sur le réseau local, 127.0.0.1 pour local only)
HOST=127.0.0.1

# Dossier racine des projets créés en mode PC (défaut : ./workspaces)
# SUPERNOVA_WORKSPACES=/chemin/vers/mes/projets

# Mets 1 pour désactiver totalement l'exécution de commandes shell
# SUPERNOVA_DISABLE_SHELL=1
